# Copy to .env and fill in. Never commit .env.
KAIROS_ENV=dev
# Secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KAIROS_TOKEN_SECRET=change-me
KAIROS_ALLOWED_ORIGINS=http://localhost:8000
# Speed-2 answer rewrite: local | gemini | openai_compatible | ollama | none
KAIROS_LLM_PROVIDER=local
# Optional hosted providers (leave empty to stay fully offline)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_HOST=http://ollama:11434
# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
